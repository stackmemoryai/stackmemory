{
  "name": "GEPA - Genetic Eval-driven Prompt Algorithm",
  "version": "2.0.0",

  "target": {
    "file": "CLAUDE.md",
    "scope": "project",
    "backup": true
  },

  "targets": [
    {
      "name": "global",
      "file": "~/.claude/CLAUDE.md",
      "evals": ["coding-tasks.jsonl"],
      "description": "Global rules affecting every session"
    },
    {
      "name": "provenantai",
      "file": "~/Dev/provenantai/.claude/CLAUDE.md",
      "evals": ["coding-tasks.jsonl"],
      "description": "Project conventions (Express, Jest, migrations)"
    },
    {
      "name": "dispatch",
      "file": "~/Dev/provenantai/.claude/commands/dispatch.md",
      "evals": ["conductor-tasks.jsonl"],
      "description": "Agent orchestration prompt"
    },
    {
      "name": "stackmemory",
      "file": "CLAUDE.md",
      "evals": ["stackmemory-tasks.jsonl"],
      "description": "StackMemory project prompt"
    },
    {
      "name": "skill:start",
      "file": "~/.claude/commands/start.md",
      "evals": ["skill-tasks.jsonl"],
      "description": "Session boot skill"
    },
    {
      "name": "skill:stop",
      "file": "~/.claude/commands/stop.md",
      "evals": ["skill-tasks.jsonl"],
      "description": "Session close skill"
    },
    {
      "name": "skill:learn",
      "file": "~/.claude/commands/learn.md",
      "evals": ["skill-tasks.jsonl"],
      "description": "Session review + artifact update skill"
    },
    {
      "name": "skill:next",
      "file": "~/.claude/commands/next.md",
      "evals": ["skill-tasks.jsonl"],
      "description": "Next action recommendation skill"
    },
    {
      "name": "skill:summary",
      "file": "~/.claude/commands/summary.md",
      "evals": ["skill-tasks.jsonl"],
      "description": "Session summary skill"
    }
  ],

  "evolution": {
    "populationSize": 8,
    "crossoverCount": 2,
    "elitism": true,
    "generations": 10,
    "selectionRate": 0.5,
    "selfReview": true,
    "mutationStrategies": [
      "rephrase",
      "add_examples",
      "remove_redundancy",
      "restructure",
      "add_constraints",
      "simplify",
      "add_xml_structure",
      "add_role",
      "add_motivation",
      "calibrate_tool_usage",
      "add_self_check",
      "reduce_overengineering"
    ]
  },

  "evals": {
    "directory": "./evals",
    "minSamplesPerVariant": 25,
    "timeout": 120000,
    "heldOutPartition": true,
    "metrics": [
      "task_completion",
      "code_quality",
      "instruction_following",
      "efficiency",
      "no_overengineering",
      "no_hallucination"
    ]
  },

  "judge": {
    "model": "claude-haiku-4-5-20251001",
    "maxOutputTokens": 2000,
    "timeoutMs": 120000,
    "feedbackEnabled": true
  },

  "mutation": {
    "model": "claude-sonnet-4-6",
    "maxOutputTokens": 8000
  },

  "scoring": {
    "weights": {
      "task_completion": 0.3,
      "code_quality": 0.2,
      "instruction_following": 0.2,
      "efficiency": 0.1,
      "no_overengineering": 0.1,
      "no_hallucination": 0.1
    },
    "threshold": 0.7
  },

  "hooks": {
    "trackToolCalls": true,
    "trackTokenUsage": true,
    "trackErrors": true,
    "trackUserFeedback": true
  },

  "profiles": {
    "claude-md": {
      "target": {
        "file": "CLAUDE.md",
        "scope": "project",
        "backup": true
      },
      "evolution": {
        "mutationStrategies": [
          "rephrase",
          "add_examples",
          "remove_redundancy",
          "restructure",
          "add_constraints",
          "simplify",
          "add_xml_structure",
          "add_motivation",
          "calibrate_tool_usage",
          "reduce_overengineering"
        ]
      },
      "evals": {
        "files": ["stackmemory-tasks.jsonl", "coding-tasks.jsonl"]
      }
    },
    "conductor": {
      "target": {
        "file": "~/.stackmemory/conductor/prompt-template.md",
        "scope": "user",
        "backup": true
      },
      "evolution": {
        "mutationStrategies": [
          "add_guardrails",
          "improve_error_handling",
          "add_examples",
          "simplify",
          "add_role",
          "add_self_check"
        ]
      },
      "evals": {
        "files": ["conductor-tasks.jsonl"]
      }
    },
    "skills": {
      "target": {
        "file": "~/.claude/commands/start.md",
        "scope": "user",
        "backup": true
      },
      "evolution": {
        "mutationStrategies": [
          "simplify",
          "add_examples",
          "rephrase",
          "add_constraints",
          "reduce_overengineering",
          "add_self_check"
        ]
      },
      "evals": {
        "files": ["skill-tasks.jsonl"]
      }
    }
  }
}
