{
  "name": "GEPA - Genetic Eval-driven Prompt Algorithm",
  "version": "2.0.0",

  "target": {
    "file": "CLAUDE.md",
    "scope": "project",
    "backup": true
  },

  "evolution": {
    "populationSize": 4,
    "generations": 10,
    "selectionRate": 0.5,
    "selfReview": true,
    "mutationStrategies": [
      "rephrase",
      "add_examples",
      "remove_redundancy",
      "restructure",
      "add_constraints",
      "simplify",
      "add_xml_structure",
      "add_role",
      "add_motivation",
      "calibrate_tool_usage",
      "add_self_check",
      "reduce_overengineering"
    ]
  },

  "evals": {
    "directory": "./evals",
    "minSamplesPerVariant": 8,
    "timeout": 120000,
    "metrics": [
      "task_completion",
      "code_quality",
      "instruction_following",
      "efficiency",
      "no_overengineering",
      "no_hallucination"
    ]
  },

  "judge": {
    "model": "claude-haiku-4-5-20251001",
    "maxOutputTokens": 2000,
    "timeoutMs": 30000
  },

  "mutation": {
    "model": "claude-sonnet-4-6",
    "maxOutputTokens": 8000
  },

  "scoring": {
    "weights": {
      "task_completion": 0.3,
      "code_quality": 0.2,
      "instruction_following": 0.2,
      "efficiency": 0.1,
      "no_overengineering": 0.1,
      "no_hallucination": 0.1
    },
    "threshold": 0.7
  },

  "hooks": {
    "trackToolCalls": true,
    "trackTokenUsage": true,
    "trackErrors": true,
    "trackUserFeedback": true
  },

  "profiles": {
    "claude-md": {
      "target": {
        "file": "CLAUDE.md",
        "scope": "project",
        "backup": true
      },
      "evolution": {
        "mutationStrategies": [
          "rephrase",
          "add_examples",
          "remove_redundancy",
          "restructure",
          "add_constraints",
          "simplify",
          "add_xml_structure",
          "add_motivation",
          "calibrate_tool_usage",
          "reduce_overengineering"
        ]
      },
      "evals": {
        "files": ["stackmemory-tasks.jsonl", "coding-tasks.jsonl"]
      }
    },
    "conductor": {
      "target": {
        "file": "~/.stackmemory/conductor/prompt-template.md",
        "scope": "user",
        "backup": true
      },
      "evolution": {
        "mutationStrategies": [
          "add_guardrails",
          "improve_error_handling",
          "add_examples",
          "simplify",
          "add_role",
          "add_self_check"
        ]
      },
      "evals": {
        "files": ["conductor-tasks.jsonl"]
      }
    }
  }
}
